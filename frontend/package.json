{
	"name": "ray-player1-frontend",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "npm@11.16.0",
	"engines": {
		"node": ">=24.0.0 <25",
		"npm": ">=11.0.0 <12"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"test": "node --experimental-strip-types --test",
		"check": "biome ci --diagnostic-level=error .",
		"check:types": "svelte-check --tsconfig ./tsconfig.json",
		"deps:check": "npm ls --depth=0"
	},
	"dependencies": {
		"@lucide/svelte": "1.26.0",
		"clsx": "2.1.1",
		"svelte": "5.56.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"svelte-check": "4.7.4",
		"typescript": "5.9.3",
		"vite": "8.1.5"
	}
}
